<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinRT(Windows.Graphics.Capture) ?ъ쁺???ъ슜?섍린 ?꾪빐 Windows SDK TFM 吏??-->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ProjectorWarp</RootNamespace>
    <AssemblyName>ProjectorWarp</AssemblyName>
    <!-- 由대━???쒓렇(vX.Y.Z)? ??媛믪쓣 留욎떠???먮룞 ?낅뜲?댄듃媛 ??踰꾩쟾???뚯븘蹂몃떎 -->
    <Version>1.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\ProjectorWarp.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- ?⑥씪 ?ㅽ뻾?뚯씪(self-contained) 諛고룷 湲곕낯媛?-->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- 寃利앹슜 肄섏넄 ?꾨줈?앺듃? ?꾩씠肄??앹꽦湲곕뒗 ???댁뀍釉붾━???ы븿?섏? ?딅뒗??-->
    <Compile Remove="tests\**" />
    <Compile Remove="tools\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WindowsDesktop SDK ???붿떆??using 紐⑸줉?먮뒗 System.IO 媛 鍮좎졇 ?덉뼱 吏곸젒 異붽??쒕떎 -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- 李??꾩씠肄?Window.Icon)?쇰줈 ?곌린 ?꾪빐 由ъ냼?ㅻ줈???ы븿?쒕떎 -->
    <Resource Include="assets\ProjectorWarp.ico" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\UI\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="src\UI\**\*.xaml" Exclude="src\UI\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <!-- HLSL ?먮낯? 由ъ냼?ㅻ줈 ?ы븿?섍퀬 ?ㅽ뻾 ??D3DCompile 濡?而댄뙆?쇳븳??-->
    <EmbeddedResource Include="src\Rendering\Shaders\*.hlsl" />
    <None Remove="src\Rendering\Shaders\*.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
