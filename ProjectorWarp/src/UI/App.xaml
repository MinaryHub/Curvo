<Application x:Class="Curvo.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>

    <!--
      디자인 토큰. 색은 모두 이 블록에만 둔다.
      다른 팔레트(예: 다크)로 바꿀 때 아래 브러시 값만 교체하면 된다.
    -->
    <SolidColorBrush x:Key="Surface" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAlt" Color="#FBFCFE" />
    <SolidColorBrush x:Key="Line" Color="#DFE5EE" />
    <SolidColorBrush x:Key="LineStrong" Color="#C7D0DE" />
    <SolidColorBrush x:Key="Text" Color="#1B2430" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7787" />
    <SolidColorBrush x:Key="Accent" Color="#0F7EA6" />
    <SolidColorBrush x:Key="AccentHover" Color="#1291BD" />
    <SolidColorBrush x:Key="AccentPressed" Color="#0B6786" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F4F9" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Sponsor" Color="#BF3989" />
    <SolidColorBrush x:Key="SponsorSoft" Color="#FCEEF6" />
    <SolidColorBrush x:Key="Danger" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA" />

    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>

    <!-- 기본 타이포그래피 -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- 보조 설명문. 예전에 Opacity 로 흐리게 하던 자리를 대체한다. -->
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- 카드형 GroupBox -->
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Border Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                        CornerRadius="5,5,0,0" Padding="11,7">
                  <ContentPresenter ContentSource="Header" TextBlock.FontWeight="SemiBold"
                                    TextBlock.FontSize="12.5"
                                    TextBlock.Foreground="{StaticResource Text}" />
                </Border>

                <ContentPresenter Grid.Row="1" Margin="11,9,11,11" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 버튼 -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinHeight" Value="27" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Line}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Surface}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 주 동작(출력 시작)용 강조 버튼 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="15,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentPressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource LineStrong}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 후원 버튼. 주 동작(출력 시작)보다 조용해야 하므로 채우지 않고 테두리만 강조한다. -->
    <Style x:Key="SponsorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Sponsor}" />
      <Setter Property="BorderBrush" Value="{StaticResource Sponsor}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource SponsorSoft}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Sponsor}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 입력 -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Margin" Value="0,3,0,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

  </Application.Resources>
</Application>
