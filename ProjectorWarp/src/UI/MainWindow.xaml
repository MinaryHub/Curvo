<Window x:Class="ProjectorWarp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectorWarp — 프로젝터 곡면 워핑" Height="840" Width="500"
        MinWidth="460" MinHeight="620"
        Icon="/assets/ProjectorWarp.ico"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal"
        Closing="OnWindowClosing" SizeChanged="OnWindowLayoutChanged" LocationChanged="OnWindowLayoutChanged">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 상태 -->
    <Border Grid.Row="0" Background="{StaticResource AccentSoft}"
            BorderBrush="{StaticResource Accent}" BorderThickness="1,1,1,1"
            Padding="11,8" CornerRadius="{StaticResource RadiusCard}" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" CornerRadius="2" Background="{StaticResource Accent}" Margin="0,0,9,0" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="준비"
                   VerticalAlignment="Center" MaxWidth="430" />
      </StackPanel>
    </Border>

    <!-- 선택한 소스 미리보기(DWM 썸네일) -->
    <Border x:Name="PreviewArea" Grid.Row="1" Height="150" Margin="0,0,0,10" Visibility="Collapsed"
            Background="#0E1520" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}">
      <TextBlock x:Name="PreviewPlaceholder" Text="[창] 탭에서 캡처할 창을 고르면 미리보기가 표시됩니다."
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#7C8B9E" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                 MaxWidth="300" />
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 1. 소스 -->
        <GroupBox Header="1. 소스">
          <StackPanel>
            <TabControl x:Name="SourceTabs" SelectionChanged="OnSourceTabChanged">
              <TabItem Header="내장 재생">
                <StackPanel Height="150" Margin="4">
                  <TextBlock Text="외부 플레이어 · PowerPoint 없이 앱이 직접 재생합니다."
                             Style="{StaticResource Hint}" Margin="0,0,0,8" />
                  <WrapPanel>
                    <Button x:Name="OpenVideoButton" Content="동영상 열기" Click="OnOpenVideoClick" />
                    <Button x:Name="OpenSlidesButton" Content="슬라이드 열기 (PPT · PDF · 이미지)" Click="OnOpenSlidesClick" />
                    <Button x:Name="CloseMediaButton" Content="닫기" Click="OnCloseMediaClick" />
                  </WrapPanel>
                  <TextBlock x:Name="MediaFileText" Text="열린 파일이 없습니다." TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock x:Name="MediaHintText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                             Text="PPT 는 가져올 때 PowerPoint 로 이미지 변환을 한 번 수행합니다. PowerPoint 가 없으면 PDF 로 내보낸 파일을 사용하세요." />
                </StackPanel>
              </TabItem>
              <TabItem Header="창">
                <ListBox x:Name="WindowList" Height="150" SelectionChanged="OnWindowSelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                        <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextMuted}"
                                   Margin="8,0,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </TabItem>
            </TabControl>

            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="RefreshButton" Content="목록 새로고침" Click="OnRefreshClick" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="소스를 고른 뒤 아래 [출력 시작] 을 누르면 화면에 나갑니다. 출력 중에 소스를 바꾸면 바로 전환됩니다." />
          </StackPanel>
        </GroupBox>

        <!-- 2. 출력 -->
        <GroupBox Header="2. 출력 (화면 표시)">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="출력 모니터" />
            <ComboBox x:Name="OutputMonitorCombo" DisplayMemberPath="Description" Padding="6,4" />
            <WrapPanel Margin="0,9,0,0">
              <Button x:Name="StartOutputButton" Content="출력 시작" Click="OnStartOutputClick"
                      Style="{StaticResource PrimaryButton}" />
              <Button x:Name="StopOutputButton" Content="출력 중지" Click="OnStopOutputClick" />
              <CheckBox x:Name="TopmostCheck" Content="항상 위" IsChecked="False" Margin="10,0,0,6"
                        Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" />
            </WrapPanel>
            <Border x:Name="FeedbackWarningArea" Background="{StaticResource DangerSoft}"
                    BorderBrush="{StaticResource Danger}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="8,6" Margin="0,2,0,0"
                    Visibility="Collapsed">
              <TextBlock x:Name="FeedbackWarning" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                         FontSize="11.5"
                         Text="캡처 소스와 출력이 같은 모니터입니다. 피드백 루프가 발생할 수 있습니다." />
            </Border>
          </StackPanel>
        </GroupBox>

        <!-- 재생 제어 (내장 재생 전용) -->
        <GroupBox x:Name="PlaybackGroup" Header="재생 제어 (내장 재생 전용)" IsEnabled="False">
          <StackPanel>
            <WrapPanel>
              <Button x:Name="PlayPauseButton" Content="재생 / 일시정지 (Space)" Click="OnPlayPauseClick" />
              <Button x:Name="RestartMediaButton" Content="처음부터" Click="OnRestartMediaClick" />
              <CheckBox x:Name="LoopCheck" Content="반복" IsChecked="True" Margin="8,4,12,0"
                        Checked="OnLoopChanged" Unchecked="OnLoopChanged" />
            </WrapPanel>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="위치" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="PositionSlider" Minimum="0" Maximum="1"
                      ValueChanged="OnPositionChanged" />
              <TextBlock Grid.Column="2" x:Name="PositionText" VerticalAlignment="Center"
                         HorizontalAlignment="Right" Text="0:00 / 0:00" />
            </Grid>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="음량" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8"
                      ValueChanged="OnVolumeChanged" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat=P0}" />
            </Grid>

            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="PreviousSlideButton" Content="◀ 이전 (PgUp)" Click="OnPreviousSlideClick" />
              <Button x:Name="NextSlideButton" Content="다음 ▶ (PgDn)" Click="OnNextSlideClick" />
              <TextBlock x:Name="SlideIndexText" VerticalAlignment="Center" Margin="8,4,0,0" Text="" />
            </WrapPanel>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="62" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="자동 전환" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="SlideIntervalSlider" Minimum="0" Maximum="120" TickFrequency="5"
                      IsSnapToTickEnabled="True" Value="0" ValueChanged="OnSlideIntervalChanged" />
              <TextBlock Grid.Column="2" x:Name="SlideIntervalText" VerticalAlignment="Center"
                         HorizontalAlignment="Right" Text="수동" />
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 3. 기하 보정 -->
        <GroupBox Header="3. 기하 보정">
          <StackPanel>
            <CheckBox x:Name="CornerPinCheck" Content="코너 핀 / 키스톤 사용"
                      Checked="OnGeometryToggleChanged" Unchecked="OnGeometryToggleChanged" />
            <CheckBox x:Name="BezierCheck" Content="베지어 곡면 워핑 사용" IsChecked="True" Margin="0,4,0,0"
                      Checked="OnGeometryToggleChanged" Unchecked="OnGeometryToggleChanged" />

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="제어점 격자" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="GridSizeCombo" SelectionChanged="OnGridSizeChanged" />
            </Grid>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="테셀레이션" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="TessellationSlider" Minimum="16" Maximum="128" TickFrequency="16"
                      IsSnapToTickEnabled="True" Value="64" ValueChanged="OnTessellationChanged" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding ElementName=TessellationSlider, Path=Value, StringFormat=F0}" />
            </Grid>

            <WrapPanel Margin="0,8,0,0">
              <CheckBox x:Name="EditModeCheck" Content="편집 모드(F1)" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
              <CheckBox x:Name="ControlGridCheck" Content="제어점 격자" IsChecked="True" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
              <CheckBox x:Name="ReferenceGridCheck" Content="참조 그리드(F3)" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
              <CheckBox x:Name="DiagonalCheck" Content="대각선(F4)" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
            </WrapPanel>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="테스트 패턴(F2)" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="PatternCombo" SelectionChanged="OnPatternChanged" />
            </Grid>

            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="ResetButton" Content="워핑 초기화(Ctrl+R)" Click="OnResetClick" />
              <Button x:Name="UndoButton" Content="실행 취소" Click="OnUndoClick" />
              <Button x:Name="RedoButton" Content="다시 실행" Click="OnRedoClick" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <!-- 4. 마스킹 -->
        <GroupBox Header="4. 마스킹 (선택)">
          <StackPanel>
            <CheckBox x:Name="MaskEnableCheck" Content="블랙 마스크 사용"
                      Checked="OnGeometryToggleChanged" Unchecked="OnGeometryToggleChanged" />
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="AddMaskButton" Content="마스크 추가(M)" Click="OnAddMaskClick" />
              <Button x:Name="DeleteMaskButton" Content="선택 마스크 삭제(Del)" Click="OnDeleteMaskClick" />
            </WrapPanel>
            <TextBlock Text="편집 모드에서 꼭짓점을 드래그하고, 오른쪽 클릭으로 꼭짓점을 삭제합니다."
                       Style="{StaticResource Hint}" Margin="0,6,0,0" />
          </StackPanel>
        </GroupBox>

        <!-- 5. 색상 보정 -->
        <GroupBox Header="5. 색상 보정 (선택)">
          <StackPanel>
            <CheckBox x:Name="ColorEnableCheck" Content="색상 보정 사용"
                      Checked="OnColorChanged" Unchecked="OnColorChanged" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="밝기" VerticalAlignment="Center" />
              <Slider Grid.Row="0" Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="2" Value="1"
                      ValueChanged="OnColorChanged" />
              <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat=F2}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="대비" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1"
                      ValueChanged="OnColorChanged" />
              <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=ContrastSlider, Path=Value, StringFormat=F2}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="감마" VerticalAlignment="Center" />
              <Slider Grid.Row="2" Grid.Column="1" x:Name="GammaSlider" Minimum="0.2" Maximum="3" Value="1"
                      ValueChanged="OnColorChanged" />
              <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=GammaSlider, Path=Value, StringFormat=F2}" />
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 6. 엣지 블렌딩 -->
        <GroupBox Header="6. 엣지 블렌딩 (멀티 프로젝터)">
          <StackPanel>
            <CheckBox x:Name="EdgeBlendCheck" Content="엣지 블렌딩 사용"
                      Checked="OnEdgeBlendChanged" Unchecked="OnEdgeBlendChanged" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="좌" VerticalAlignment="Center" />
              <Slider Grid.Row="0" Grid.Column="1" x:Name="BlendLeftSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendLeftSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="우" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" x:Name="BlendRightSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendRightSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="상" VerticalAlignment="Center" />
              <Slider Grid.Row="2" Grid.Column="1" x:Name="BlendTopSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendTopSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="하" VerticalAlignment="Center" />
              <Slider Grid.Row="3" Grid.Column="1" x:Name="BlendBottomSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendBottomSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="감마" VerticalAlignment="Center" />
              <Slider Grid.Row="4" Grid.Column="1" x:Name="BlendGammaSlider" Minimum="0.5" Maximum="4" Value="2.2"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendGammaSlider, Path=Value, StringFormat=F2}" />
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 7. 프리셋 -->
        <GroupBox Header="7. 프리셋">
          <WrapPanel>
            <Button x:Name="SavePresetButton" Content="다른 이름으로 저장(Ctrl+S)" Click="OnSavePresetClick" />
            <Button x:Name="OpenPresetButton" Content="열기(Ctrl+O)" Click="OnOpenPresetClick" />
          </WrapPanel>
        </GroupBox>

        <!-- 8. 설정 저장 / 자동 시작 -->
        <GroupBox Header="8. 저장 · 자동 시작">
          <StackPanel>
            <Button x:Name="SaveConfigurationButton" Content="현재 설정 저장" Click="OnSaveConfigurationClick"
                    HorizontalAlignment="Left" />
            <TextBlock Text="보정값 · 소스 · 출력 모니터 · 아래 자동 시작 옵션을 함께 저장합니다."
                       Style="{StaticResource Hint}" Margin="0,0,0,8" />

            <CheckBox x:Name="LaunchAtLogonCheck" Content="Windows 로그온 시 자동 실행" Margin="0,4,0,0"
                      Checked="OnLaunchAtLogonChanged" Unchecked="OnLaunchAtLogonChanged" />
            <CheckBox x:Name="AutoStartProjectionCheck" Content="앱 시작 시 자동으로 출력·캡처 시작" Margin="0,4,0,0"
                      Checked="OnAutoStartOptionChanged" Unchecked="OnAutoStartOptionChanged" />
            <CheckBox x:Name="StartMinimizedCheck" Content="컨트롤 패널을 최소화 상태로 시작" Margin="0,4,0,0"
                      Checked="OnAutoStartOptionChanged" Unchecked="OnAutoStartOptionChanged" />

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="재시도 시간" VerticalAlignment="Center" Margin="0,0,8,0"
                         ToolTip="자동 시작 시 캡처 대상(창)이 아직 실행되지 않았을 때 기다리는 최대 시간" />
              <Slider Grid.Column="1" x:Name="AutoStartRetrySlider" Minimum="0" Maximum="300" TickFrequency="10"
                      IsSnapToTickEnabled="True" Value="60" ValueChanged="OnAutoStartOptionChanged" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding ElementName=AutoStartRetrySlider, Path=Value, StringFormat={}{0:F0}초}" />
            </Grid>

            <TextBlock Text="시작 시 사용할 프리셋" Margin="0,8,0,2" />
            <TextBlock x:Name="StartupPresetText" Text="마지막 상태" Style="{StaticResource Hint}" />
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="ChooseStartupPresetButton" Content="프리셋 선택" Click="OnChooseStartupPresetClick" />
              <Button x:Name="ClearStartupPresetButton" Content="마지막 상태 사용" Click="OnClearStartupPresetClick" />
              <Button x:Name="CancelAutoStartButton" Content="자동 시작 취소" Click="OnCancelAutoStartClick" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <!-- 9. 버전 · 업데이트 -->
        <GroupBox Header="9. 버전 · 업데이트">
          <StackPanel>
            <TextBlock x:Name="VersionText" Text="버전 —" FontWeight="SemiBold" />

            <TextBlock x:Name="UpdateSourceText" Text="업데이트 확인 대상 —" Style="{StaticResource Hint}" Margin="0,3,0,0"
                       ToolTip="배포처는 빌드에 고정되어 있습니다(AppConfig.UpdateRepository)." />
            <CheckBox x:Name="CheckUpdateOnStartupCheck" Content="앱을 시작할 때 새 버전 확인" Margin="0,8,0,0"
                      Checked="OnUpdateOptionChanged" Unchecked="OnUpdateOptionChanged" />

            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="OnCheckUpdateClick" />
              <Button x:Name="ApplyUpdateButton" Content="설치 후 재시작" Click="OnApplyUpdateClick"
                      Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="" />
            <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,4,0,0" Maximum="1"
                         Visibility="Collapsed" />
          </StackPanel>
        </GroupBox>

        <!-- 10. 후원 -->
        <GroupBox Header="10. 후원">
          <StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="ProjectorWarp 가 쓸 만했다면 개발을 후원해 주세요. 굽은 벽면 투사에 필요한 기능을 다듬는 데 씁니다." />
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="SponsorButton" Content="♥  GitHub Sponsors 로 후원하기"
                      Style="{StaticResource SponsorButton}" Click="OnSponsorClick" />
              <Button x:Name="CopySponsorLinkButton" Content="링크 복사" Click="OnCopySponsorLinkClick" />
            </WrapPanel>
            <TextBlock x:Name="SponsorUrlText" Style="{StaticResource Hint}" Margin="0,2,0,0" />
          </StackPanel>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Margin="2,10,2,0" Style="{StaticResource Hint}"
               Text="출력 창 단축키 — F1 편집 모드 · F2 테스트 패턴 · F3 참조 그리드 · F4 대각선 · Space 재생/일시정지 · PgUp/PgDn 슬라이드 · Ctrl+S/O 프리셋 · Ctrl+R 초기화 · Ctrl+Z/Y 실행취소/다시실행 · Esc 전체화면 해제 · 방향키 미세 이동(Shift 10px)" />
  </Grid>
</Window>
