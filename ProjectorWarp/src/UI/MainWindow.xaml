<Window x:Class="ProjectorWarp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectorWarp — Curved Surface Warping" Height="840" Width="500"
        MinWidth="460" MinHeight="620"
        Icon="/assets/ProjectorWarp.ico"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal"
        Closing="OnWindowClosing" SizeChanged="OnWindowLayoutChanged" LocationChanged="OnWindowLayoutChanged">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 상태 -->
    <Border Grid.Row="0" Background="{StaticResource AccentSoft}"
            BorderBrush="{StaticResource Accent}" BorderThickness="1,1,1,1"
            Padding="11,8" CornerRadius="{StaticResource RadiusCard}" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" CornerRadius="2" Background="{StaticResource Accent}" Margin="0,0,9,0" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Ready"
                   VerticalAlignment="Center" MaxWidth="430" />
      </StackPanel>
    </Border>

    <!-- 선택한 소스 미리보기(DWM 썸네일) -->
    <Border x:Name="PreviewArea" Grid.Row="1" Height="150" Margin="0,0,0,10" Visibility="Collapsed"
            Background="#0E1520" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}">
      <TextBlock x:Name="PreviewPlaceholder" Text="Pick a window on the Window tab to see a live preview here."
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#7C8B9E" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                 MaxWidth="300" />
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 1. 소스 -->
        <GroupBox Header="1. Source">
          <StackPanel>
            <TabControl x:Name="SourceTabs" SelectionChanged="OnSourceTabChanged">
              <TabItem Header="Built-in playback">
                <StackPanel Height="150" Margin="4">
                  <TextBlock Text="Plays inside the app — no external player or PowerPoint window to keep alive."
                             Style="{StaticResource Hint}" Margin="0,0,0,8" />
                  <WrapPanel>
                    <Button x:Name="OpenVideoButton" Content="Open video" Click="OnOpenVideoClick" />
                    <Button x:Name="OpenSlidesButton" Content="Open slides (PPT · PDF · image)" Click="OnOpenSlidesClick" />
                    <Button x:Name="CloseMediaButton" Content="Close" Click="OnCloseMediaClick" />
                  </WrapPanel>
                  <TextBlock x:Name="MediaFileText" Text="No file open." TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock x:Name="MediaHintText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                             Text="PPT files are converted to images once, on import, using PowerPoint. Without PowerPoint installed, export to PDF and open that instead." />
                </StackPanel>
              </TabItem>
              <TabItem Header="Window">
                <ListBox x:Name="WindowList" Height="150" SelectionChanged="OnWindowSelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                        <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextMuted}"
                                   Margin="8,0,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </TabItem>
            </TabControl>

            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="RefreshButton" Content="Refresh list" Click="OnRefreshClick" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="Choose a source, then press Start output below. Changing the source while the output is on switches it right away." />
          </StackPanel>
        </GroupBox>

        <!-- 2. 출력 -->
        <GroupBox Header="2. Output (what goes on screen)">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Output monitor" />
            <ComboBox x:Name="OutputMonitorCombo" DisplayMemberPath="Description" Padding="6,4" />
            <WrapPanel Margin="0,9,0,0">
              <Button x:Name="StartOutputButton" Content="Start output" Click="OnStartOutputClick"
                      Style="{StaticResource PrimaryButton}" />
              <Button x:Name="StopOutputButton" Content="Stop output" Click="OnStopOutputClick" />
              <CheckBox x:Name="TopmostCheck" Content="Always on top" IsChecked="False" Margin="10,0,0,6"
                        Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" />
            </WrapPanel>
            <Border x:Name="FeedbackWarningArea" Background="{StaticResource DangerSoft}"
                    BorderBrush="{StaticResource Danger}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="8,6" Margin="0,2,0,0"
                    Visibility="Collapsed">
              <TextBlock x:Name="FeedbackWarning" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                         FontSize="11.5"
                         Text="The capture source and the output are on the same monitor, which can create a feedback loop." />
            </Border>
          </StackPanel>
        </GroupBox>

        <!-- 재생 제어 (내장 재생 전용) -->
        <GroupBox x:Name="PlaybackGroup" Header="Playback (built-in playback only)" IsEnabled="False">
          <StackPanel>
            <WrapPanel>
              <Button x:Name="PlayPauseButton" Content="Play / pause (Space)" Click="OnPlayPauseClick" />
              <Button x:Name="RestartMediaButton" Content="Restart" Click="OnRestartMediaClick" />
              <CheckBox x:Name="LoopCheck" Content="Loop" IsChecked="True" Margin="8,4,12,0"
                        Checked="OnLoopChanged" Unchecked="OnLoopChanged" />
            </WrapPanel>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Position" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="PositionSlider" Minimum="0" Maximum="1"
                      ValueChanged="OnPositionChanged" />
              <TextBlock Grid.Column="2" x:Name="PositionText" VerticalAlignment="Center"
                         HorizontalAlignment="Right" Text="0:00 / 0:00" />
            </Grid>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8"
                      ValueChanged="OnVolumeChanged" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat=P0}" />
            </Grid>

            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="PreviousSlideButton" Content="◀ Previous (PgUp)" Click="OnPreviousSlideClick" />
              <Button x:Name="NextSlideButton" Content="Next ▶ (PgDn)" Click="OnNextSlideClick" />
              <TextBlock x:Name="SlideIndexText" VerticalAlignment="Center" Margin="8,4,0,0" Text="" />
            </WrapPanel>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="62" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Auto advance" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="SlideIntervalSlider" Minimum="0" Maximum="120" TickFrequency="5"
                      IsSnapToTickEnabled="True" Value="0" ValueChanged="OnSlideIntervalChanged" />
              <TextBlock Grid.Column="2" x:Name="SlideIntervalText" VerticalAlignment="Center"
                         HorizontalAlignment="Right" Text="Manual" />
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 3. 기하 보정 -->
        <GroupBox Header="3. Geometry">
          <StackPanel>
            <CheckBox x:Name="CornerPinCheck" Content="Corner pin / keystone"
                      Checked="OnGeometryToggleChanged" Unchecked="OnGeometryToggleChanged" />
            <CheckBox x:Name="BezierCheck" Content="Bézier surface warping" IsChecked="True" Margin="0,4,0,0"
                      Checked="OnGeometryToggleChanged" Unchecked="OnGeometryToggleChanged" />

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Control grid" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="GridSizeCombo" SelectionChanged="OnGridSizeChanged" />
            </Grid>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Tessellation" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider Grid.Column="1" x:Name="TessellationSlider" Minimum="16" Maximum="128" TickFrequency="16"
                      IsSnapToTickEnabled="True" Value="64" ValueChanged="OnTessellationChanged" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding ElementName=TessellationSlider, Path=Value, StringFormat=F0}" />
            </Grid>

            <WrapPanel Margin="0,8,0,0">
              <CheckBox x:Name="EditModeCheck" Content="Edit mode (F1)" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
              <CheckBox x:Name="ControlGridCheck" Content="Control grid" IsChecked="True" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
              <CheckBox x:Name="ReferenceGridCheck" Content="Reference grid (F3)" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
              <CheckBox x:Name="DiagonalCheck" Content="Diagonals (F4)" Margin="0,4,12,4"
                        Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" />
            </WrapPanel>

            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Test pattern (F2)" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="PatternCombo" SelectionChanged="OnPatternChanged" />
            </Grid>

            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="ResetButton" Content="Reset warp (Ctrl+R)" Click="OnResetClick" />
              <Button x:Name="UndoButton" Content="Undo" Click="OnUndoClick" />
              <Button x:Name="RedoButton" Content="Redo" Click="OnRedoClick" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <!-- 4. 색상 보정 -->
        <GroupBox Header="4. Colour (optional)">
          <StackPanel>
            <CheckBox x:Name="ColorEnableCheck" Content="Colour correction"
                      Checked="OnColorChanged" Unchecked="OnColorChanged" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Brightness" VerticalAlignment="Center" />
              <Slider Grid.Row="0" Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="2" Value="1"
                      ValueChanged="OnColorChanged" />
              <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat=F2}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Contrast" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1"
                      ValueChanged="OnColorChanged" />
              <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=ContrastSlider, Path=Value, StringFormat=F2}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Gamma" VerticalAlignment="Center" />
              <Slider Grid.Row="2" Grid.Column="1" x:Name="GammaSlider" Minimum="0.2" Maximum="3" Value="1"
                      ValueChanged="OnColorChanged" />
              <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=GammaSlider, Path=Value, StringFormat=F2}" />
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 5. 엣지 블렌딩 -->
        <GroupBox Header="5. Edge blending (multi-projector)">
          <StackPanel>
            <CheckBox x:Name="EdgeBlendCheck" Content="Edge blending"
                      Checked="OnEdgeBlendChanged" Unchecked="OnEdgeBlendChanged" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center" />
              <Slider Grid.Row="0" Grid.Column="1" x:Name="BlendLeftSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendLeftSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Right" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" x:Name="BlendRightSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendRightSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Top" VerticalAlignment="Center" />
              <Slider Grid.Row="2" Grid.Column="1" x:Name="BlendTopSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendTopSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Bottom" VerticalAlignment="Center" />
              <Slider Grid.Row="3" Grid.Column="1" x:Name="BlendBottomSlider" Minimum="0" Maximum="0.5"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendBottomSlider, Path=Value, StringFormat=F3}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Gamma" VerticalAlignment="Center" />
              <Slider Grid.Row="4" Grid.Column="1" x:Name="BlendGammaSlider" Minimum="0.5" Maximum="4" Value="2.2"
                      ValueChanged="OnEdgeBlendChanged" />
              <TextBlock Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding ElementName=BlendGammaSlider, Path=Value, StringFormat=F2}" />
            </Grid>
          </StackPanel>
        </GroupBox>

        <!-- 6. 프리셋 -->
        <GroupBox Header="6. Presets">
          <WrapPanel>
            <Button x:Name="SavePresetButton" Content="Save as (Ctrl+S)" Click="OnSavePresetClick" />
            <Button x:Name="OpenPresetButton" Content="Open (Ctrl+O)" Click="OnOpenPresetClick" />
          </WrapPanel>
        </GroupBox>

        <!-- 7. 설정 저장 / 자동 시작 -->
        <GroupBox Header="7. Saving · auto-start">
          <StackPanel>
            <Button x:Name="SaveConfigurationButton" Content="Save current setup" Click="OnSaveConfigurationClick"
                    HorizontalAlignment="Left" />
            <TextBlock Text="Saves the correction values, the source, the output monitor and the auto-start options below."
                       Style="{StaticResource Hint}" Margin="0,0,0,8" />

            <CheckBox x:Name="LaunchAtLogonCheck" Content="Launch at Windows logon" Margin="0,4,0,0"
                      Checked="OnLaunchAtLogonChanged" Unchecked="OnLaunchAtLogonChanged" />
            <CheckBox x:Name="AutoStartProjectionCheck" Content="Start projecting when the app starts" Margin="0,4,0,0"
                      Checked="OnAutoStartOptionChanged" Unchecked="OnAutoStartOptionChanged" />
            <CheckBox x:Name="StartMinimizedCheck" Content="Start with the control panel minimised" Margin="0,4,0,0"
                      Checked="OnAutoStartOptionChanged" Unchecked="OnAutoStartOptionChanged" />

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Retry for" VerticalAlignment="Center" Margin="0,0,8,0"
                         ToolTip="How long auto-start keeps looking for the capture target while that window is not running yet" />
              <Slider Grid.Column="1" x:Name="AutoStartRetrySlider" Minimum="0" Maximum="300" TickFrequency="10"
                      IsSnapToTickEnabled="True" Value="60" ValueChanged="OnAutoStartOptionChanged" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding ElementName=AutoStartRetrySlider, Path=Value, StringFormat={}{0:F0} s}" />
            </Grid>

            <TextBlock Text="Preset to load at start" Margin="0,8,0,2" />
            <TextBlock x:Name="StartupPresetText" Text="Last state" Style="{StaticResource Hint}" />
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="ChooseStartupPresetButton" Content="Choose preset" Click="OnChooseStartupPresetClick" />
              <Button x:Name="ClearStartupPresetButton" Content="Use last state" Click="OnClearStartupPresetClick" />
              <Button x:Name="CancelAutoStartButton" Content="Cancel auto-start" Click="OnCancelAutoStartClick" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <!-- 8. 버전 · 업데이트 -->
        <GroupBox Header="8. Version · updates">
          <StackPanel>
            <TextBlock x:Name="VersionText" Text="Version —" FontWeight="SemiBold" />

            <TextBlock x:Name="UpdateSourceText" Text="Update source —" Style="{StaticResource Hint}" Margin="0,3,0,0"
                       ToolTip="The release repository is fixed at build time (AppConfig.UpdateRepository)." />
            <CheckBox x:Name="CheckUpdateOnStartupCheck" Content="Check for a new version at start-up" Margin="0,8,0,0"
                      Checked="OnUpdateOptionChanged" Unchecked="OnUpdateOptionChanged" />

            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="OnCheckUpdateClick" />
              <Button x:Name="ApplyUpdateButton" Content="Install and restart" Click="OnApplyUpdateClick"
                      Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="" />
            <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,4,0,0" Maximum="1"
                         Visibility="Collapsed" />
          </StackPanel>
        </GroupBox>

        <!-- 9. 후원 -->
        <GroupBox Header="9. Sponsor">
          <StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="If ProjectorWarp earned its place in your setup, consider sponsoring it. Support goes into the work that curved-surface projection actually needs." />
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="SponsorButton" Content="♥  Sponsor on GitHub"
                      Style="{StaticResource SponsorButton}" Click="OnSponsorClick" />
              <Button x:Name="CopySponsorLinkButton" Content="Copy link" Click="OnCopySponsorLinkClick" />
            </WrapPanel>
            <TextBlock x:Name="SponsorUrlText" Style="{StaticResource Hint}" Margin="0,2,0,0" />
          </StackPanel>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Margin="2,10,2,0" Style="{StaticResource Hint}"
               Text="Output window — F1 edit mode · F2 test pattern · F3 reference grid · F4 diagonals · Space play/pause · PgUp/PgDn slides · Ctrl+S/O presets · Ctrl+R reset · Ctrl+Z/Y undo/redo · Esc leave fullscreen · arrow keys nudge (Shift 10px)" />
  </Grid>
</Window>
